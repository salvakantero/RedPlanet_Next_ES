'CREA LAS ANIMACIONES DEL SPRITE DEL JUGADOR

IF PLAYER_DYING
        SET_PLAYER_ANIMATION(8, 4,4,4,4)        ' ANIMACIÓN DE MUERTE
ELSE IF PLAYER_ON_LADDER AND PLAYER_GOING_UP
        SET_PLAYER_ANIMATION(4, 5,6,5,6)        ' ANIMACIÓN SUBIENDO
ELSE IF PLAYER_ON_LADDER AND PLAYER_GOING_DOWN
        SET_PLAYER_ANIMATION(4, 5,6,5,6)        ' ANIMACIÓN BAJANDO
ELSE IF PLAYER_ON_LADDER
        SET_PLAYER_ANIMATION(99, 5,5,5,5)        ' ANIMACIÓN EN ESCALERA
ELSE IF PLAYER_JUMPING 
        SET_PLAYER_ANIMATION(8, 3,3,4,4)        ' ANIMACIÓN SALTANDO
ELSE IF PLAYER_WALKING
        SET_PLAYER_ANIMATION(6, 0,2,1,3)        ' ANIMACIÓN ANDANDO
ELSE IF PLAYER_SHOOTING
        SET_PLAYER_ANIMATION(8, 6,6,6,6)        ' ANIMACIÓN DISPARANDO
ELSE
        SET_PLAYER_ANIMATION(8, 0,0,1,1)        ' ANIMACIÓN EN REPOSO
END IF
